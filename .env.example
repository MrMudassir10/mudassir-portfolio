# Copy this file to .env.local and fill it in. Never commit .env.local.

# The AI assistant calls OpenAI from the server (src/app/api/chat/route.ts).
# Without a key it still works, using short built-in answers from your own data.
OPENAI_API_KEY=
# Any chat model your account can use.
OPENAI_MODEL=gpt-4o-mini

# Your public address once deployed, for link previews, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
